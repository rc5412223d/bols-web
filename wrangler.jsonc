{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",

  "name": "bols-auth",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",

  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChatRoom"
      ]
    }
  ]
}
